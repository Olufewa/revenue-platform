          "name": "02 · Ingest Revenue Event (First Time)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('externalId', `txn_${stamp}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 202 Accepted', () => {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Duplicate is false on first submission', () => {",
                  "    pm.expect(json.duplicate).to.be.false;",
                  "    pm.expect(json.event).to.be.an('object');",
                  "    pm.expect(json.event.externalId).to.eql(pm.collectionVariables.get('externalId'));",
                  "    pm.expect(json.event.amountMinor).to.eql('250000');",
                  "    pm.collectionVariables.set('eventId', json.event.id);",
                  "});"
                ]
              }
            }
