  "item": [
    {
      "name": "1 · Identity & Authentication",
      "item": [
        {
          "name": "01 · Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('testEmail', `user_${stamp}@mtn.test`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('User created without exposing passwordHash', () => {",
                  "    pm.expect(json.id).to.be.a('string');",
                  "    pm.expect(json.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "    pm.expect(json.name).to.eql('Jane Doe');",
                  "    pm.expect(json.passwordHash).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"Jane Doe\"\n}"
