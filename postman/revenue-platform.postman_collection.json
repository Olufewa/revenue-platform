{
  "info": {
    "name": "MTN Revenue Platform",
    "description": "Comprehensive API collection for the MTN Revenue Platform.\n\nCovers all currently implemented modules:\n1. Identity & Authentication (register, login, me, validation and conflict checks)\n2. Service Onboarding & API Keys (services CRUD, minting keys, whoami, key revocation)\n3. Revenue Events (event ingest, idempotency deduplication, event queries, dashboard views, and summary aggregates)\n\n### How to run:\n1. Start the server: in `packages/server`, run `npm run start:dev`\n2. In Postman, click **Import** and select this file (`postman/revenue-platform.postman_collection.json`)\n3. Click **Run collection** to run the entire suite automatically from top to bottom.\nAll tokens, service IDs, and API keys are captured and passed forward via collection variables automatically!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3003",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "Password123!",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "serviceSlug",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "apiKeyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ingestApiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "ingestApiKeyId",
      "value": "",
      "type": "string"
