{
  "info": {
    "name": "MTN Revenue Platform — Service Onboarding",
    "description": "Module 3: services, API keys and roles.\n\nThis collection runs top to bottom on its own. It registers a user, logs in, creates a service, mints a key, uses the key, revokes it and proves the revoked key stops working. Nothing needs copying by hand — the token, the service id and the API key all move between requests as collection variables.\n\nStart the server first:  cd packages/server && npm run start:dev\n\nTwo checks the runner can't do for you, both explained in docs/04-service-onboarding.md: the 403 you get on another user's service, and the ADMIN-only DELETE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "testEmail", "value": "", "type": "string" },
    { "key": "testPassword", "value": "supersecret1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "serviceId", "value": "", "type": "string" },
    { "key": "serviceSlug", "value": "", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" },
    { "key": "apiKeyId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0 · Setup — register and log in",
      "item": [
        {
          "name": "0a · Register a fresh user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('testEmail', `fewa+${stamp}@mtn.test`);",
                  "// Slugs are globally unique, so this one has to be fresh too.",
                  "pm.collectionVariables.set('serviceSlug', `mtn-airtime-${stamp}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"name\": \"Fewa\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "New users default to MEMBER — see the Role enum in schema.prisma."
          }
        },
        {
          "name": "0b · Log in and save the token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "1 · Create a service — 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "pm.test('slug came back as sent', () => {",
              "  pm.expect(body.slug).to.eql(pm.collectionVariables.get('serviceSlug'));",
              "});",
              "pm.test('owned by the caller', () => pm.expect(body.ownerId).to.be.a('string'));",
              "",
              "pm.collectionVariables.set('serviceId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"MTN Airtime\",\n  \"slug\": \"{{serviceSlug}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/services",
          "host": ["{{baseUrl}}"],
          "path": ["services"]
        },
        "description": "ownerId comes from the JWT, never from the body. If it were a DTO field, anyone could create a service owned by someone else."
      }
    },
    {
      "name": "2 · Same slug again — 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('names the slug', () => {",
              "  pm.expect(pm.response.json().message).to.include('already taken');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"MTN Airtime again\",\n  \"slug\": \"{{serviceSlug}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/services",
          "host": ["{{baseUrl}}"],
          "path": ["services"]
        },
        "description": "Slugs are unique across the whole platform because they end up in URLs and reports."
      }
    },
    {
      "name": "3 · A bad slug — 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('explains the slug rule', () => {",
              "  pm.expect(pm.response.json().message.join(' ')).to.include('lowercase');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Bad Slug Service\",\n  \"slug\": \"MTN Airtime!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/services",
          "host": ["{{baseUrl}}"],
          "path": ["services"]
        },
        "description": "Spaces, capitals and punctuation are rejected by the @Matches rule on the DTO before the service layer ever runs."
      }
    },
    {
      "name": "4 · List my services — 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "const list = pm.response.json();",
              "pm.test('contains the service just created', () => {",
              "  const id = pm.collectionVariables.get('serviceId');",
              "  pm.expect(list.map(s => s.id)).to.include(id);",
              "});",
              "pm.test('as a MEMBER, only my own', () => {",
              "  const mine = list.every(s => s.ownerId === list[0].ownerId);",
              "  pm.expect(mine).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/services",
          "host": ["{{baseUrl}}"],
          "path": ["services"]
        },
        "description": "A MEMBER sees only their own services. An ADMIN sees everyone's. That split lives in ServicesService.findAllFor, not in a guard — a guard can only say yes or no, it cannot narrow a list."
      }
    },
    {
      "name": "5 · Unknown service id — 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/services/does-not-exist",
          "host": ["{{baseUrl}}"],
          "path": ["services", "does-not-exist"]
        },
        "description": "404 for an id that does not exist, 403 for one that does but belongs to someone else. Distinguishing them is safe here because service ids are cuids nobody can guess."
      }
    },
    {
      "name": "6 · Mint an API key — 201, shown once",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "",
              "const body = pm.response.json();",
              "",
              "pm.test('full key looks like sk_live_<publicId>_<secret>', () => {",
              "  pm.expect(body.key).to.match(/^sk_live_[0-9a-f]{16}_[A-Za-z0-9_-]{20,}$/);",
              "});",
              "pm.test('prefix is the lookup half only', () => {",
              "  pm.expect(body.key.startsWith(body.prefix)).to.be.true;",
              "  pm.expect(body.prefix.length).to.be.below(body.key.length);",
              "});",
              "pm.test('no hash in the response', () => {",
              "  pm.expect(pm.response.text()).to.not.include('secretHash');",
              "});",
              "",
              "pm.collectionVariables.set('apiKey', body.key);",
              "pm.collectionVariables.set('apiKeyId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"staging\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/services/{{serviceId}}/keys",
          "host": ["{{baseUrl}}"],
          "path": ["services", "{{serviceId}}", "keys"]
        },
        "description": "The only response in the whole API that contains a full key. Only the sha256 of the secret half is stored, so it genuinely cannot be shown again."
      }
    },
    {
      "name": "7 · List keys — the secret is gone for good",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "const keys = pm.response.json();",
              "const full = pm.collectionVariables.get('apiKey');",
              "const secret = full.split('_')[3];",
              "",
              "pm.test('the full key is not in the list', () => {",
              "  pm.expect(pm.response.text()).to.not.include(secret);",
              "});",
              "pm.test('no secretHash either', () => {",
              "  pm.expect(pm.response.text()).to.not.include('secretHash');",
              "});",
              "pm.test('key is active', () => {",
              "  const k = keys.find(k => k.id === pm.collectionVariables.get('apiKeyId'));",
              "  pm.expect(k.active).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/services/{{serviceId}}/keys",
          "host": ["{{baseUrl}}"],
          "path": ["services", "{{serviceId}}", "keys"]
        },
        "description": "publicKey() decides what leaves the building, the same way publicUser() does in IdentityService. The prefix is enough to match a key against the one in your config and useless to anyone else."
      }
    },
    {
      "name": "8 · whoami with the API key — 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('is the service the key belongs to', () => {",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('serviceId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/services/whoami",
          "host": ["{{baseUrl}}"],
          "path": ["services", "whoami"]
        },
        "description": "No JWT anywhere. ApiKeyGuard splits the key, looks the row up by publicId, sha256s the secret half and compares with timingSafeEqual. This is the route machines will use to check their credentials from module 4 on."
      }
    },
    {
      "name": "9 · whoami with a tampered key — 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('says invalid, and nothing more', () => {",
              "  pm.expect(pm.response.json().message).to.eql('Invalid API key');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{apiKey}}xxxx" }],
        "url": {
          "raw": "{{baseUrl}}/services/whoami",
          "host": ["{{baseUrl}}"],
          "path": ["services", "whoami"]
        },
        "description": "A real publicId with a wrong secret. The row is found, the hash does not match, and the answer is the same 'Invalid API key' an unknown publicId gets — the error never reveals which half was wrong."
      }
    },
    {
      "name": "10 · whoami with no key — 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('says the header is missing', () => {",
              "  pm.expect(pm.response.json().message).to.include('Missing x-api-key');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/services/whoami",
          "host": ["{{baseUrl}}"],
          "path": ["services", "whoami"]
        }
      }
    },
    {
      "name": "11 · Revoke the key — 200, row survives",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "pm.test('revokedAt is set', () => pm.expect(body.revokedAt).to.be.a('string'));",
              "pm.test('active is false', () => pm.expect(body.active).to.be.false);",
              "pm.test('the row still exists', () => pm.expect(body.id).to.eql(pm.collectionVariables.get('apiKeyId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/services/{{serviceId}}/keys/{{apiKeyId}}",
          "host": ["{{baseUrl}}"],
          "path": ["services", "{{serviceId}}", "keys", "{{apiKeyId}}"]
        },
        "description": "DELETE, but the row stays with revokedAt set. A deleted key leaves no record of what it did; a revoked one stops working and stays in the audit trail — which matters once these keys are posting money."
      }
    },
    {
      "name": "12 · The revoked key no longer works — 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "pm.test('same message as any other bad key', () => {",
              "  pm.expect(pm.response.json().message).to.eql('Invalid API key');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/services/whoami",
          "host": ["{{baseUrl}}"],
          "path": ["services", "whoami"]
        },
        "description": "The exact key that returned 200 in request 8. The guard checks revokedAt before it checks the hash."
      }
    },
    {
      "name": "13 · Delete the service as MEMBER — 403",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
              "",
              "// Set role = 'ADMIN' on your user row and re-run this: it becomes 204.",
              "// The role is read from the database on every request, so your existing",
              "// token keeps working - you do not need to log in again."
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/services/{{serviceId}}",
          "host": ["{{baseUrl}}"],
          "path": ["services", "{{serviceId}}"]
        },
        "description": "Owning a service is not enough to delete it — deleting takes it and every key on it out of the system, so it is ADMIN only. Two guards run in order: AuthGuard establishes who you are, RolesGuard checks what you may do."
      }
    }
  ]
}
