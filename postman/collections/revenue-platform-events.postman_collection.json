{
  "info": {
    "name": "MTN Revenue Platform — Event Ingest",
    "description": "Module 4: revenue events, idempotency, and money as integers.\n\nRuns top to bottom on its own — it builds its own user, service and API key, then exercises ingest. Start the server first:  cd packages/server && npm run start:dev\n\nThe centrepiece is requests 2–4: the same event posted three times, and a count that never moves.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3003", "type": "string" },
    { "key": "testEmail", "value": "", "type": "string" },
    { "key": "testPassword", "value": "supersecret1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "serviceId", "value": "", "type": "string" },
    { "key": "serviceSlug", "value": "", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" },
    { "key": "otherServiceId", "value": "", "type": "string" },
    { "key": "otherApiKey", "value": "", "type": "string" },
    { "key": "externalId", "value": "", "type": "string" },
    { "key": "eventId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0 · Setup",
      "item": [
        {
          "name": "0a · Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now();",
                  "pm.collectionVariables.set('testEmail', `fewa+${stamp}@mtn.test`);",
                  "pm.collectionVariables.set('serviceSlug', `airtime-${stamp}`);",
                  "pm.collectionVariables.set('externalId', `airtime-txn-${stamp}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"name\": \"Fewa\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "0b · Log in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "0c · Create the service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('serviceId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MTN Airtime\",\n  \"slug\": \"{{serviceSlug}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/services", "host": ["{{baseUrl}}"], "path": ["services"] }
          }
        },
        {
          "name": "0d · Mint its API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('apiKey', pm.response.json().key);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ingest\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/services/{{serviceId}}/keys",
              "host": ["{{baseUrl}}"],
              "path": ["services", "{{serviceId}}", "keys"]
            }
          }
        },
        {
          "name": "0e · A second service, to prove isolation later",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('otherServiceId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MTN Data\",\n  \"slug\": \"data-{{serviceSlug}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/services", "host": ["{{baseUrl}}"], "path": ["services"] }
          }
        },
        {
          "name": "0f · And its key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('otherApiKey', pm.response.json().key);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ingest\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/services/{{otherServiceId}}/keys",
              "host": ["{{baseUrl}}"],
              "path": ["services", "{{otherServiceId}}", "keys"]
            }
          }
        }
      ]
    },
    {
      "name": "1 · Post an event — 202 Accepted",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('202 Accepted, not 201', () => pm.response.to.have.status(202));",
              "",
              "const body = pm.response.json();",
              "pm.test('not a duplicate', () => pm.expect(body.duplicate).to.be.false);",
              "pm.test('status starts PENDING', () => pm.expect(body.event.status).to.eql('PENDING'));",
              "pm.test('amount comes back as a string, not a float', () => {",
              "  pm.expect(body.event.amountMinor).to.eql('250000');",
              "});",
              "pm.test('metadata survived as sent', () => {",
              "  pm.expect(body.event.metadata.channel).to.eql('ussd');",
              "});",
              "",
              "pm.collectionVariables.set('eventId', body.event.id);"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalId\": \"{{externalId}}\",\n  \"type\": \"airtime.purchase\",\n  \"amountMinor\": 250000,\n  \"currency\": \"NGN\",\n  \"occurredAt\": \"2026-09-08T14:32:00.000Z\",\n  \"metadata\": { \"channel\": \"ussd\" }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
        "description": "250000 is ₦2,500.00 in kobo. No serviceId in the body — it comes from the key. 202 rather than 201 because the event is recorded but not yet posted to the ledger."
      }
    },
    {
      "name": "2 · Post it again — same id, duplicate: true",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
              "",
              "const body = pm.response.json();",
              "pm.test('flagged as duplicate', () => pm.expect(body.duplicate).to.be.true);",
              "pm.test('returns the original row, not a new one', () => {",
              "  pm.expect(body.event.id).to.eql(pm.collectionVariables.get('eventId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalId\": \"{{externalId}}\",\n  \"type\": \"airtime.purchase\",\n  \"amountMinor\": 250000,\n  \"currency\": \"NGN\",\n  \"occurredAt\": \"2026-09-08T14:32:00.000Z\",\n  \"metadata\": { \"channel\": \"ussd\" }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
        "description": "A client that timed out and retried. It gets 202 and the original event, so it can stop retrying — and revenue is not counted twice."
      }
    },
    {
      "name": "3 · A third time, with a different amount — still the original",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
              "",
              "const body = pm.response.json();",
              "pm.test('duplicate', () => pm.expect(body.duplicate).to.be.true);",
              "pm.test('the stored amount did NOT change', () => {",
              "  pm.expect(body.event.amountMinor).to.eql('250000');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalId\": \"{{externalId}}\",\n  \"type\": \"airtime.purchase\",\n  \"amountMinor\": 999999,\n  \"currency\": \"NGN\",\n  \"occurredAt\": \"2026-09-08T14:32:00.000Z\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
        "description": "The externalId is the identity of the event. Once recorded, a later body claiming a different amount does not overwrite it — first write wins, and the discrepancy is a matter for an adjustment in module 6, not a silent edit."
      }
    },
    {
      "name": "4 · The count did not move",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "const body = pm.response.json();",
              "pm.test('exactly one event after three posts', () => {",
              "  pm.expect(body.events.length).to.eql(1);",
              "});",
              "pm.test('it is the one we created', () => {",
              "  pm.expect(body.events[0].id).to.eql(pm.collectionVariables.get('eventId'));",
              "});",
              "pm.test('nextCursor is null on a single page', () => {",
              "  pm.expect(body.nextCursor).to.eql(null);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
        "description": "The whole point of the module in one assertion: three identical posts, one row."
      }
    },
    {
      "name": "5 · A float amount — 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('explains minor units', () => {",
              "  pm.expect(pm.response.json().message.join(' ')).to.include('whole number');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalId\": \"float-{{externalId}}\",\n  \"type\": \"airtime.purchase\",\n  \"amountMinor\": 2500.55,\n  \"currency\": \"NGN\",\n  \"occurredAt\": \"2026-09-08T14:32:00.000Z\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
        "description": "Money never enters this system as a float. 0.1 + 0.2 is 0.30000000000000004 — one such error is invisible, a million of them is a reconciliation nobody can explain."
      }
    },
    {
      "name": "6 · A bad currency and a bad type — 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
              "",
              "const messages = pm.response.json().message.join(' | ');",
              "pm.test('rejects the currency', () => pm.expect(messages).to.include('3-letter code'));",
              "pm.test('rejects the type', () => pm.expect(messages).to.include('airtime.purchase'));"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalId\": \"bad-{{externalId}}\",\n  \"type\": \"Airtime Purchase\",\n  \"amountMinor\": 250000,\n  \"currency\": \"naira\",\n  \"occurredAt\": \"2026-09-08T14:32:00.000Z\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
      }
    },
    {
      "name": "7 · Read the event back by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('still PENDING', () => pm.expect(pm.response.json().status).to.eql('PENDING'));"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}"]
        },
        "description": "PENDING until module 5 turns it into ledger entries and flips it to POSTED."
      }
    },
    {
      "name": "8 · Another service's key cannot read it — 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('does not confirm the event exists', () => {",
              "  pm.expect(pm.response.json().message).to.include('No such event');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{otherApiKey}}" }],
        "url": {
          "raw": "{{baseUrl}}/events/{{eventId}}",
          "host": ["{{baseUrl}}"],
          "path": ["events", "{{eventId}}"]
        },
        "description": "A perfectly valid key, a perfectly valid id — and still nothing. The lookup filters on { id, serviceId }, so scope always comes from the credential rather than the URL."
      }
    },
    {
      "name": "9 · The same externalId on another service is a different event",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
              "",
              "const body = pm.response.json();",
              "pm.test('NOT a duplicate', () => pm.expect(body.duplicate).to.be.false);",
              "pm.test('a genuinely new row', () => {",
              "  pm.expect(body.event.id).to.not.eql(pm.collectionVariables.get('eventId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{otherApiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalId\": \"{{externalId}}\",\n  \"type\": \"data.bundle\",\n  \"amountMinor\": 100000,\n  \"currency\": \"NGN\",\n  \"occurredAt\": \"2026-09-08T15:00:00.000Z\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] },
        "description": "The unique index is on (serviceId, externalId), not externalId alone — so two teams can both use 'invoice-1' without colliding."
      }
    },
    {
      "name": "10 · The human view of the same events",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('one event on this service', () => {",
              "  pm.expect(pm.response.json().events.length).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/services/{{serviceId}}/events",
          "host": ["{{baseUrl}}"],
          "path": ["services", "{{serviceId}}", "events"]
        },
        "description": "Same data, JWT instead of an API key, ownership checked through assertCanAccess. Machines post; people look."
      }
    },
    {
      "name": "11 · Summary totals by currency and status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "const rows = pm.response.json();",
              "const ngn = rows.find(r => r.currency === 'NGN' && r.status === 'PENDING');",
              "pm.test('one PENDING NGN row', () => pm.expect(ngn.count).to.eql(1));",
              "pm.test('totalling 250000 kobo', () => pm.expect(ngn.totalMinor).to.eql('250000'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/services/{{serviceId}}/events/summary",
          "host": ["{{baseUrl}}"],
          "path": ["services", "{{serviceId}}", "events", "summary"]
        },
        "description": "Grouped by currency and status, never summed across currencies — adding naira to dollars is a bug, not a total."
      }
    },
    {
      "name": "12 · No API key — 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/events", "host": ["{{baseUrl}}"], "path": ["events"] }
      }
    }
  ]
}
