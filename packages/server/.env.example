# Supabase -> Connect -> Session pooler (port 5432)
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres"

# openssl rand -base64 32
JWT_SECRET="replace-me"
PORT=3003

# Optional: server used by `npm run test:e2e`. Each run creates a throwaway
