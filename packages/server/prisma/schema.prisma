generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum EventStatus {
  PENDING
  POSTED
  FAILED
}

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
}

enum EntryDirection {
  DEBIT
  CREDIT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services Service[]
}

model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User           @relation(fields: [ownerId], references: [id])
  apiKeys      ApiKey[]
  events       RevenueEvent[]
  postingRules PostingRule[]
  entries      Entry[]
}

model ApiKey {
  id         String    @id @default(cuid())
  publicId   String    @unique
  secretHash String
  name       String
  serviceId  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model RevenueEvent {
  id            String      @id @default(cuid())
  serviceId     String
  externalId    String
  type          String
  amountMinor   BigInt
  currency      String
  occurredAt    DateTime
  metadata      Json?
  status        EventStatus @default(PENDING)
  receivedAt      DateTime    @default(now())
  failureReason   String?
  reversesEventId String?

  service    Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  entries    Entry[]
  reverses   RevenueEvent?  @relation("EventReversals", fields: [reversesEventId], references: [id])
  reversedBy RevenueEvent[] @relation("EventReversals")

  @@unique([serviceId, externalId])
  @@index([serviceId, occurredAt])
  @@index([serviceId, status])
  @@index([reversesEventId])
}

model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  createdAt DateTime    @default(now())

  entries Entry[]
}

model PostingRule {
  id            String   @id @default(cuid())
  serviceId     String
  eventType     String
  effectiveFrom DateTime
  lines         Json
  createdAt     DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, eventType, effectiveFrom])
}

model Entry {
  id          String         @id @default(cuid())
  eventId     String
  serviceId   String
  accountId   String
  direction   EntryDirection
  amountMinor BigInt
  currency    String
  occurredAt  DateTime
  bookedAt    DateTime       @default(now())

  event   RevenueEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@index([serviceId, occurredAt])
  @@index([eventId])
}
