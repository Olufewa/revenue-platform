generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum EntryDirection {
  DEBIT
  CREDIT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services Service[]
}

model Service {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  baseCurrency String   @default("NGN")
  ownerId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User                @relation(fields: [ownerId], references: [id])
  apiKeys      ApiKey[]
  accounts     Account[]
  orders       Order[]
  transactions LedgerTransaction[]
  entries      Entry[]
}

model ApiKey {
  id         String    @id @default(cuid())
  publicId   String    @unique
  secretHash String
  name       String
  serviceId  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model Account {
  id        String      @id @default(cuid())
  serviceId String
  code      String
  name      String
  type      AccountType
  createdAt DateTime    @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  entries Entry[]

  @@unique([serviceId, code])
}

model Order {
  id          String   @id @default(cuid())
  serviceId   String
  externalId  String
  amountMinor BigInt
  currency    String
  description String?
  customerRef String?
  metadata    Json?
  placedAt    DateTime
  createdAt   DateTime @default(now())

  service      Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  transactions LedgerTransaction[]

  @@unique([serviceId, externalId])
  @@index([serviceId, placedAt])
}

model LedgerTransaction {
  id                    String   @id @default(cuid())
  serviceId             String
  orderId               String
  externalId            String
  description           String?
  currency              String
  exchangeRate          String
  occurredAt            DateTime
  createdAt             DateTime @default(now())
  reversesTransactionId String?  @unique

  service    Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reverses   LedgerTransaction? @relation("TransactionReversal", fields: [reversesTransactionId], references: [id])
  reversedBy LedgerTransaction? @relation("TransactionReversal")
  entries    Entry[]

  @@unique([serviceId, externalId])
  @@index([orderId])
}

model Entry {
  id              String         @id @default(cuid())
  transactionId   String
  serviceId       String
  accountId       String
  direction       EntryDirection
  amountMinor     BigInt
  baseAmountMinor BigInt
  occurredAt      DateTime

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  account     Account           @relation(fields: [accountId], references: [id])

  @@index([serviceId, occurredAt])
  @@index([accountId])
  @@index([transactionId])
}
