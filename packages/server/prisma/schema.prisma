generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// MEMBER can only see and change their own services.
// ADMIN can see and change everyone's.
enum Role {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services Service[]
}

// An onboarded MTN product that will post revenue events.
model Service {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id])
  apiKeys ApiKey[]
}

// The full key is never stored. What is stored is:
//   publicId   - the lookup half, so a key can be found without knowing it
//   secretHash - sha256 of the secret half, so a stolen database is not a
//                stolen set of keys
// The caller presents  sk_live_<publicId>_<secret>  and we rebuild the hash.
model ApiKey {
  id         String    @id @default(cuid())
  publicId   String    @unique
  secretHash String
  name       String
  serviceId  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}
